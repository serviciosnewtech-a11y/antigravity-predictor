# Antigravity Predictor — demo-safe defaults
DASHBOARD_PORT=80
PREDICTOR_PORT=18910
EXECUTOR_PORT=18911
FORGE_PORT=18912

# Left blank on purpose — deploy/docker/docker-compose.yml already defaults
# these to ../../models, ../../data, ../../logs, ../../forge_data (resolved
# relative to the compose file's own location, i.e. the deploy root, per
# Docker Compose's path-resolution rules). A hardcoded `./models` here used
# to be correct back when docker-compose.yml lived at the repo root, but
# after the deploy/docker + deploy/bare-metal split moved it two directories
# deeper, that same `./models` silently resolved to deploy/docker/models
# instead — an empty directory — so predictor mounted nothing and crashed
# on startup with "Could not open models/model_btc_long.txt". Overriding
# these here means duplicating a path assumption in two files that has to
# be kept in sync by hand; leaving them blank means there's exactly one
# source of truth (the compose file itself), so this can't drift again if
# the layout ever changes. Only set these if you actually need
# models/data/logs to live somewhere other than the deploy directory.
MODELS_DIR=
DATA_DIR=
LOGS_DIR=
FORGE_DATA_DIR=

# Default inference path: disabled. Core client demo requires no LLM, no Hermes,
# no Anthropic, and no Ollama. Set openai_compatible/hermes_proxy/ollama/claude
# only when enrichment is intentionally configured.
SA_INFERENCE_BACKEND=disabled

# ── Chat backend — two supported patterns, pick one ─────────────────────────
# predictor_server.py's chat surfaces (_call_llm_backend()) only ever speak
# one contract: POST {HERMES_PROXY_URL}/chat/completions, OpenAI-style. The
# var name "HERMES_PROXY_URL" is not Hermes-specific — it accepts ANY backend
# that implements that one route, remote or local.
#
# Pattern A — remote OpenAI-compatible API (no local inference needed):
#   HERMES_PROXY_URL=https://inference-api.nousresearch.com/v1
#   HERMES_INFERENCE_MODEL=step-3.7-flash:free
#   HERMES_PROXY_API_KEY=<your provider's API key>
#   (Example above is Nous Research's Nous Portal, which offered
#   Step-3.7-Flash free for a limited window — swap in whatever
#   provider/model you're actually using; nothing in the code is
#   provider-specific.)
#
# Pattern B — local, agent-agnostic CLI relay (tools/agent_chat_relay.py) —
# DEFAULT for the bare-metal/monolith product. This runs a dedicated,
# isolated CLI agent instance per message — its own profile/session, not
# shared with anything else on this machine, and structurally no tool
# access (see the module docstring in tools/agent_chat_relay.py and the
# Crypto Operator Agent system prompt in src/predictor_server.py for
# exactly what "isolated" and "no tools" mean here — it's not a policy,
# there's no tool-calling code path wired up at all).
#
# Agent-agnostic by design: AGENT_RELAY_CMD is a full shell command
# template with a {prompt} placeholder — point it at ANY local CLI-based
# agent, not just Hermes. Default runs a "metis" Hermes CLI profile
# (preserves this project's original demo persona with zero config
# changes), but you can swap in a different Hermes profile, a completely
# different agent tool, or your own script, e.g.:
#   AGENT_RELAY_CMD=hermes --profile ops chat -q {prompt}
#   AGENT_RELAY_CMD=mycli --agent trader ask {prompt}
#   AGENT_RELAY_CMD=python3 tools/my_agent.py {prompt}
#
#   ENABLE_AGENT_RELAY=true      (run_monolith.sh starts the relay for you
#                                  and auto-points HERMES_PROXY_URL at it if
#                                  you leave HERMES_PROXY_URL unset below)
#   AGENT_RELAY_CMD=             (optional — defaults to
#                                  'hermes --profile metis chat -q {prompt}')
#   AGENT_RELAY_PORT=8645
# Whatever binary AGENT_RELAY_CMD names must actually be installed and on
# PATH on THIS machine — this is a local subprocess call, not a network
# service. If it isn't found, run_monolith.sh still starts cleanly and
# /api/chat/status will show this relay as "configured", but actual
# replies will say plainly that the agent binary couldn't be invoked
# rather than silently failing or faking a reply.
# See tools/agent_chat_relay.py's module docstring for the full option list.
ENABLE_AGENT_RELAY=true
AGENT_RELAY_CMD=
AGENT_RELAY_PORT=8645

HERMES_PROXY_URL=
HERMES_INFERENCE_MODEL=operator-approved-model
HERMES_PROXY_API_KEY=local
INTERNAL_API_TOKEN=
DASHBOARD_ORIGINS=http://localhost,http://127.0.0.1

# Optional advanced fallback only, used if HERMES_PROXY_URL/the agent relay
# above are both unavailable — NOT required for client demo. Left blank by
# default on purpose: on a bare-metal deployment, a non-empty value here
# makes /api/chat/status report "configured" even if nothing is actually
# listening there, which is worse than an honest "disabled" state. Only set
# this if you've verified an Ollama server is really reachable at this URL
# from THIS machine (bare metal: typically http://127.0.0.1:11434 — NOT
# http://host.docker.internal:11434, that hostname only resolves inside a
# Docker container reaching its host, it will never resolve here).
OLLAMA_URL=
OLLAMA_MODEL=llama3.1
ANTHROPIC_API_KEY=

# ── Dashboard chat backends (predictor_server.py /api/chat + /api/tutor-chat) ──
# Both dashboard chat surfaces (the operational "Hermes" advisory chat and the
# separate "Hermes Tutor" no-execution teaching/advice chat) resolve their
# backend the same standardized way: try HERMES_PROXY_URL, then OLLAMA_URL
# (both above). Leave everything below unset to have the tutor share whatever
# backend the operational chat uses — that's the zero-config default.
#
# Only set these if you want the TUTOR to use a *different* backend/model
# than the operational chat (e.g. a smaller/cheaper/more constrained model
# for teaching, vs. a stronger one for signal commentary). Any of these left
# unset falls back to its non-TUTOR_ counterpart above.
TUTOR_HERMES_PROXY_URL=
TUTOR_HERMES_PROXY_API_KEY=
TUTOR_INFERENCE_MODEL=
TUTOR_OLLAMA_URL=
TUTOR_OLLAMA_MODEL=
# Check what's actually wired at any time: GET /api/chat/status

SA_CONFIDENCE_THRESHOLD=0.22
SA_COOLDOWN_SECONDS=900
SA_POLL_INTERVAL=30

# ── Personal admin agent (admin_agent/server.py) ─────────────────────────────
# DANGER: this gives an LLM real, UNRESTRICTED shell access on this machine,
# with no per-command confirmation, gated only by ADMIN_API_TOKEN. It is
# never linked from the public dashboard and never starts unless BOTH of
# these are set. Talk to it only via `python3 tools/admin_chat.py`, never
# expose ADMIN_AGENT_PORT beyond localhost/your own LAN.
ENABLE_ADMIN_AGENT=false
ADMIN_API_TOKEN=
ADMIN_AGENT_PORT=18913
ADMIN_COMMAND_TIMEOUT_S=25
# Optional: point the admin agent at a different backend/model than the
# dashboard chats (falls back to HERMES_PROXY_URL/OLLAMA_URL above if unset).
ADMIN_HERMES_PROXY_URL=
ADMIN_HERMES_PROXY_API_KEY=
ADMIN_INFERENCE_MODEL=
ADMIN_OLLAMA_URL=
ADMIN_OLLAMA_MODEL=

EXCHANGE=bybit
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
DRY_RUN=true
LIVE_CONFIRM=
MIN_LONG_CONF=0.60
MIN_SHORT_CONF=0.60
POSITION_SIZE_PCT=0.02
MIN_AUC=0.54
