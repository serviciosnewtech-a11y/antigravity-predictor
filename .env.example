# Antigravity Predictor — demo-safe defaults
DASHBOARD_PORT=80
PREDICTOR_PORT=18910
EXECUTOR_PORT=18911
FORGE_PORT=18912

MODELS_DIR=./models
DATA_DIR=./data
LOGS_DIR=./logs
FORGE_DATA_DIR=./forge_data

# Default inference path: disabled. Core client demo requires no LLM, no Hermes,
# no Anthropic, and no Ollama. Set openai_compatible/hermes_proxy/ollama/claude
# only when enrichment is intentionally configured.
SA_INFERENCE_BACKEND=disabled

# ── Remote inference backend (for machines with no local-inference capacity) ──
# HERMES_PROXY_URL accepts ANY OpenAI-compatible /v1/chat/completions endpoint
# — this is not Hermes-specific despite the var name (kept for continuity with
# earlier deployments). Example below is Nous Research's Nous Portal, which
# offered Step-3.7-Flash free for a limited window — replace with whatever
# provider/model you're actually using; nothing in the code is Nous-specific.
#   HERMES_PROXY_URL=https://inference-api.nousresearch.com/v1
#   HERMES_INFERENCE_MODEL=step-3.7-flash:free
#   HERMES_PROXY_API_KEY=<your Nous Portal API key>
HERMES_PROXY_URL=http://host.docker.internal:8645/v1
HERMES_INFERENCE_MODEL=operator-approved-model
HERMES_PROXY_API_KEY=local
INTERNAL_API_TOKEN=
DASHBOARD_ORIGINS=http://localhost,http://127.0.0.1

# Optional advanced fallbacks only. Not required for client demo.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
ANTHROPIC_API_KEY=

# ── Dashboard chat backends (predictor_server.py /api/chat + /api/tutor-chat) ──
# Both dashboard chat surfaces (the operational "Hermes" advisory chat and the
# separate "Hermes Tutor" no-execution teaching/advice chat) resolve their
# backend the same standardized way: try HERMES_PROXY_URL, then OLLAMA_URL
# (both above). Leave everything below unset to have the tutor share whatever
# backend the operational chat uses — that's the zero-config default.
#
# Only set these if you want the TUTOR to use a *different* backend/model
# than the operational chat (e.g. a smaller/cheaper/more constrained model
# for teaching, vs. a stronger one for signal commentary). Any of these left
# unset falls back to its non-TUTOR_ counterpart above.
TUTOR_HERMES_PROXY_URL=
TUTOR_HERMES_PROXY_API_KEY=
TUTOR_INFERENCE_MODEL=
TUTOR_OLLAMA_URL=
TUTOR_OLLAMA_MODEL=
# Check what's actually wired at any time: GET /api/chat/status

SA_CONFIDENCE_THRESHOLD=0.22
SA_COOLDOWN_SECONDS=900
SA_POLL_INTERVAL=30

# ── Personal admin agent (admin_agent/server.py) ─────────────────────────────
# DANGER: this gives an LLM real, UNRESTRICTED shell access on this machine,
# with no per-command confirmation, gated only by ADMIN_API_TOKEN. It is
# never linked from the public dashboard and never starts unless BOTH of
# these are set. Talk to it only via `python3 tools/admin_chat.py`, never
# expose ADMIN_AGENT_PORT beyond localhost/your own LAN.
ENABLE_ADMIN_AGENT=false
ADMIN_API_TOKEN=
ADMIN_AGENT_PORT=18913
ADMIN_COMMAND_TIMEOUT_S=25
# Optional: point the admin agent at a different backend/model than the
# dashboard chats (falls back to HERMES_PROXY_URL/OLLAMA_URL above if unset).
ADMIN_HERMES_PROXY_URL=
ADMIN_HERMES_PROXY_API_KEY=
ADMIN_INFERENCE_MODEL=
ADMIN_OLLAMA_URL=
ADMIN_OLLAMA_MODEL=

EXCHANGE=bybit
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
DRY_RUN=true
LIVE_CONFIRM=
MIN_LONG_CONF=0.60
MIN_SHORT_CONF=0.60
POSITION_SIZE_PCT=0.02
MIN_AUC=0.54
