[Unit]
Description=Antigravity Predictor Server
Documentation=https://github.com/serviciosnewtech-a11y/antigravity-predictor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=predictor
Group=predictor
WorkingDirectory=/opt/predictor/src

# ── Environment ───────────────────────────────────────────────────────────────
# All vars come from /opt/predictor/.env — never hardcode keys here.
# MISSING ENTIRELY until 2026-07-23: this unit never loaded .env at all
# (signal_agent.service always has), so HERMES_PROXY_URL/CHAT_BACKEND/
# ANTHROPIC_API_KEY/etc. could be set in .env forever and predictor_server.py
# (which serves /api/chat) would never see any of it — os.environ.get() just
# came up empty every time, no error, just a permanently unconfigured chat.
# Found while chasing why a real deployment's chat stayed unconfigured after
# .env was edited: predictor_server.py has no dotenv loading of its own, so
# without this line the process environment predictor.service actually runs
# with is whatever systemd itself has, period.
EnvironmentFile=-/opt/predictor/.env

# GOLD_PARQUET_PATH defaults to the relative path "data/macro/gold.parquet"
# in predictor_server.py, which resolves against WorkingDirectory (src/) —
# i.e. /opt/predictor/src/data/macro/gold.parquet. macro_refresh.service
# actually writes to /opt/predictor/data/macro (a sibling of src/, not a
# child), so without this override the gold/XAU feature would silently and
# permanently find nothing (the lookup is exists()-guarded, so it degrades
# quietly rather than crashing — easy to miss). Found during pre-redeploy
# verification.
Environment=GOLD_PARQUET_PATH=/opt/predictor/data/macro/gold.parquet

# Use the venv if present, otherwise system python
ExecStart=/opt/predictor/.venv/bin/python predictor_server.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=append:/opt/predictor/logs/predictor.log
StandardError=append:/opt/predictor/logs/predictor.log

# Resource limits — comfortable on 6vCPU / 12GB VPS
LimitNOFILE=65536
MemoryMax=3G
CPUQuota=200%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/predictor/logs /opt/predictor/models /opt/predictor/data

[Install]
WantedBy=multi-user.target
