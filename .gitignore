# Secrets
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg-info
.venv/
venv/
src/btc_lightgbm_poc.egg-info/

# Runtime data — data/ is excluded wholesale EXCEPT data/macro/*.parquet:
# those are small (~50KB each), slow-changing (daily OHLCV), fetched from a
# third-party API (yfinance) that can be flaky/rate-limited, and required
# for the dashboard's XAU/USD macro panel + /api/market-tickers to work at
# all. Shipping them pre-populated means a fresh deployment doesn't 503 on
# gold/oil/dxy/spx/vix until someone remembers to run fetch_macro.py.
# (git requires unignoring each parent level, not just the leaf pattern —
# see data/* / data/macro/* below.)
data/*
!data/macro/
data/macro/*
!data/macro/*.parquet
*.log
logs/
forge_data/

# OS / editor
.DS_Store
.vscode/
.idea/

# Model artifacts — keep production models, exclude noise
models/staging/
models/backup_*/
models/model.txt
models/model_long.txt
models/model_short.txt
models/model_*_2026070*.txt
models/top_level.txt

# Temp files
dashboard/index.html.tmp
src/__probe_test.txt
backups/

# Derived config — predictor_server.py loads config from src/config.json
# (resolved relative to its own file location). It's a copy of the
# canonical root config.json: the Dockerfile creates it via COPY at build
# time, run_local.sh syncs it fresh at every local run. It should never be
# hand-edited or committed on its own — that's exactly how a stale,
# machine-specific absolute path got baked in and committed previously.
src/config.json

# Sentinel written by retrain_all.sh in Docker mode
models/.retrain_complete

# Cached raw OHLCV parquet used by tools/retrain_live_features.py —
# regeneratable from the exchange, not a source file.
.retrain_cache/
*.tar.gz
*.tar.gz.sha256
dist/
